TOKEN=here_is_your_discord_bot_token

# Free key from https://console.groq.com/keys - leave blank to disable the AI replies
GROQ_API_KEY=

# Optional. Defaults shown; only set these if you want to change them.
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_REASONING_EFFORT=low

# Optional. Comma separated channel ids she is allowed to answer in.
# Leave unset and she answers wherever she is mentioned or named.
# AI_CHANNELS=

# ---- Leveling dashboard (website) ----
# Public address people open in the browser, no trailing slash. Also used for
# the "View full leaderboard" buttons. Leave blank to run without the website.
DASHBOARD_URL=http://localhost:3000
# Port the bot serves the dashboard on (put a reverse proxy in front for https).
DASHBOARD_PORT=3000
# 0.0.0.0 = reachable from other machines, 127.0.0.1 = only through a proxy.
# DASHBOARD_HOST=0.0.0.0
# Developer portal > OAuth2 > Client Secret. Needed for "Log in with Discord".
# Also add  <DASHBOARD_URL>/api/auth/callback  under OAuth2 > Redirects.
DISCORD_CLIENT_SECRET=
# Only if the application ID differs from the bot's user ID (it normally doesn't).
# DISCORD_CLIENT_ID=
# Set to false to turn the website off entirely.
# DASHBOARD_ENABLED=true

# ---- /bonus vote check (optional) ----
# /bonus gives extra XP for voting for the bot. If the bot is listed on
# top.gg or Koreanbots, put that site's API token here and members must vote
# before claiming. Leave both blank and /bonus is simply once a day.
# TOPGG_TOKEN=
# KOREANBOTS_TOKEN=
